#!/bin/bash

# Pre-push hook that runs code quality checks
# This replaces the GitHub Actions analyses workflow

set -e

echo "🔍 Running pre-push checks..."
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to run a check and track status
run_check() {
  local name=$1
  local command=$2

  echo "▶ Running $name..."
  if eval "$command"; then
    echo -e "${GREEN}✓ $name passed${NC}"
    echo ""
    return 0
  else
    echo -e "${RED}✗ $name failed${NC}"
    echo ""
    return 1
  fi
}

# Track if any checks fail
FAILED=0

# Run all checks
run_check "ESLint" "pnpm run lint:check" || FAILED=1
run_check "Prettier" "pnpm run prettier:check" || FAILED=1
run_check "TypeScript" "pnpm run ts:check" || FAILED=1
run_check "Unit Tests" "pnpm run test:unit" || FAILED=1

# Summary
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ $FAILED -eq 0 ]; then
  echo -e "${GREEN}✓ All checks passed! Pushing...${NC}"
  exit 0
else
  echo -e "${RED}✗ Some checks failed. Push aborted.${NC}"
  echo ""
  echo -e "${YELLOW}Fix the errors above and try again.${NC}"
  echo -e "${YELLOW}To skip this hook (not recommended): git push --no-verify${NC}"
  exit 1
fi
